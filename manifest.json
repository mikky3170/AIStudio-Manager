{
  "manifest_version": 3,
  "name": "Studio マネージャー(AI Studio 連携)",
  "version": "1.4.2",
  "description": "4つのGoogle AI Studioアカウントの使用量メーター、作業ログ、Gemini自動要約によるGitHub直接プッシュ機能を統合管理します。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://aistudio.google.com/*",
    "https://api.github.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "管理ダッシュボードを開く"
  }
}